@if (ChildContent is not null)
{
    @ChildContent
}
else
{
    <button type="button" class="@CssClass" data-privacy-settings-link hidden data-privacy-action="open-settings">Privacy settings</button>
}

@code {
    [Parameter] public string CssClass { get; set; } = "syntax-circus-consent-settings";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
